---
import '../styles/global.css'

import links from '../data/links.json'

import zenn     from '../data/zenn.json'
import note     from '../data/note.json'
import sizu     from '../data/sizu.json'
import works    from '../data/works.json'

const activities = [...zenn, ...note, ...sizu, ...works]
  .sort((a, b) => b.date.localeCompare(a.date)) // 日付降順

const years = [...new Set(activities.map(o => o.date.slice(0, 4)))].sort().reverse()

const badgeLabel: Record<string, string> = {
  article: '記事',
  talk:    '登壇',
  writing: '執筆',
  interview: 'インタビュー',
}

const featured = works.filter(o => o.featured)
---

<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta property="og:title" content="Portfolio | Choco Mint Garden">
  <meta property="og:image" content="https://naopusyu.pages.dev/ogp.png">
  <meta property="og:url" content="https://naopusyu.pages.dev">
  <meta property="og:description" content="チョコミントが好きなエンジニアのポートフォリオ">
  <meta name="twitter:card" content="summary_large_image">
  <title>Portfolio | Choco Mint Garden</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Shippori+Mincho:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/icon.png">
</head>
<body>
<div class="wrap">

<header class="header">
  <p class="header-tag">PORTFOLIO</p>
  <div class="header-name-row">
    <img class="profile-img" src="/icon.png" alt="Sunao Yada">
    <div class="header-info">
      <h1 class="name">Sunao Yada</h1>
      <p class="handle">なお (@naopusyu) </p>
      <p class="bio">🍫チョコミント🌿が好きなエンジニア</p>
      <div class="meta-tags">
        <span class="tag">PHP</span>
        <span class="tag">Laravel</span>
      </div>
    </div>
  </div>
</header>

<section>
  <p class="section-label">LINKS</p>
  <div class="links-categories">
    {links.map(group => (
      <div class="link-row">
        <span class="link-category">{group.category}</span>
        <div class="link-row-items">
          {group.items.map(item => (
            <a class="link-1" href={item.url} target="_blank" rel="noopener">
              {item.label}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<section>
  <p class="section-label">WORKS</p>
  <div class="works-list">
  {featured.map(w => (
    <a class="work-item" href={w.url} target="_blank" rel="noopener">
      <div>
        <p class="work-type">{badgeLabel[w.type]}</p>
        <p class="work-title">{w.title}</p>
        <p class="work-desc">{w.desc}</p>
      </div>
      <span class="work-arrow">↗</span>
    </a>
  ))}
  </div>
</section>

<section>
  <p class="section-label">ACTIVITY</p>
  <div class="year-tabs">
    {years.map((year, i) => (
      <button class={`year-tab ${i === 0 ? 'active' : ''}`} data-year={year}>
        {year}
      </button>
    ))}
  </div>

  {years.map((year, i) => (
    <div class={`year-block ${i === 0 ? 'active' : ''}`} data-block={year}>
      <div class="year-activities">
        {activities
          .filter(a => a.date.startsWith(year))
          .map(a => (
            <a class="activity-item" href={a.url} target="_blank" rel="noopener">
              <span class="activity-date">{a.date}</span>
              <div class="activity-meta">
                <span class={`badge badge-${a.type}`}>{badgeLabel[a.type]}</span>
                <span class="activity-source">{a.source}</span>
              </div>
              <span class="activity-title">{a.title}</span>
            </a>
          ))
        }
      </div>
    </div>
  ))}
</section>

<footer>
  <span>© 2026 Sunao Yada</span>
</footer>

</div>

<script>
  const tabs = document.querySelectorAll('.year-tab')
  const blocks = document.querySelectorAll('.year-block')

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'))
      blocks.forEach(b => b.classList.remove('active'))
      tab.classList.add('active')
      document.querySelector(`[data-block="${tab.dataset.year}"]`).classList.add('active')
    })
  })
</script>

</body>
</html>
